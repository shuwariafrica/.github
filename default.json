{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Africa/Nairobi",
  "dependencyDashboard": true,
  "configMigration": true,
  "osvVulnerabilityAlerts": true,
  "semanticCommits": "disabled",
  "commitMessagePrefix": "[task][dependencies]",
  "automerge": false,
  "packageRules": [
    {
      "description": "Scala Steward owns Scala dependencies. Renovate's sbt manager reads the same build definitions and would raise a competing pull request for every one of them.",
      "matchManagers": ["sbt"],
      "enabled": false
    }
  ]
}
