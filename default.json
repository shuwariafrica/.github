{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver",
    "workarounds:all"
  ],
  "timezone": "Africa/Nairobi",
  "dependencyDashboard": true,
  "configMigration": true,
  "osvVulnerabilityAlerts": true,
  "semanticCommits": "disabled",
  "commitMessagePrefix": "[dependencies] ",
  "automerge": false,
  "packageRules": [
    {
      "description": "Scala Steward, not Renovate's sbt manager, owns Scala dependencies.",
      "matchManagers": ["sbt"],
      "enabled": false
    },
    {
      "matchManagers": ["rust-toolchain"],
      "matchDepTypes": ["toolchain"],
      "rangeStrategy": "pin"
    },
    {
      "description": "JDK in ecosystem image tags is a platform pin moved by hand, not a version to chase; digest updates still track image rebuilds.",
      "matchPackageNames": ["shuwariafrica/*-jdk", "docker.io/shuwariafrica/*-jdk"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false
    },
    {
      "description": ".NET SDK (global.json) and the official runtime images move together; a major bump is a deliberate call, not a routine one.",
      "matchPackageNames": ["dotnet-sdk", "mcr.microsoft.com/dotnet/*"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
